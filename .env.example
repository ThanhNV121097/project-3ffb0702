# PostgreSQL user for local compose database.
POSTGRES_USER=app

# PostgreSQL password for local compose database. Replace outside git.
POSTGRES_PASSWORD=app_secret

# PostgreSQL database name for local compose database.
POSTGRES_DB=app

# Backend host port for local compose.
BACKEND_PORT=8080

# Frontend host port for local compose.
FRONTEND_PORT=3000

# Browser base URL for backend API.
NEXT_PUBLIC_API_URL=http://localhost:8080
